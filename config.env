# Defaults for k8s-mock-test. Every value can be overridden from the
# environment (GPU_TYPES="h100 b200" make container-up) or in a git-ignored
# config.local.env next to this file.

# --- cluster ---------------------------------------------------------------
# kubectl context to use; empty means the current context.
: "${KUBE_CONTEXT:=}"

# GPU types to mock. Each one is described in gpus/<type>.env.
: "${GPU_TYPES:=h100 h200 b200 gb200 gb300}"

# --- container path: KWOK fake nodes + fake-gpu-operator --------------------
: "${KWOK_VERSION:=v0.7.0}"
# Addresses KWOK gives fake pods and fake nodes. KWOK's defaults (10.0.0.1/24,
# and the controller's own pod IP for nodes) can collide with real pod IPs; the
# defaults here come from 198.18.0.0/15, reserved for benchmarking (RFC 2544).
: "${KWOK_POD_CIDR:=198.18.0.0/16}"
: "${KWOK_NODE_IP:=198.19.0.1}"
# Fake nodes created per GPU type.
: "${KWOK_NODES_PER_TYPE:=2}"
: "${FGO_CHART:=oci://ghcr.io/run-ai/fake-gpu-operator/fake-gpu-operator}"
: "${FGO_VERSION:=0.2.1}"
: "${FGO_NAMESPACE:=fake-gpu-operator}"
# Namespace the container tests run their pods in.
: "${CONTAINER_TEST_NAMESPACE:=mock-gpu-containers}"

# --- timeouts ----------------------------------------------------------------
: "${TIMEOUT:=600s}"
