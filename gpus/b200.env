# NVIDIA HGX B200: 8 x B200. Its NVLink 5 switch chips are not PCIe endpoints
# on the host, so there are no NVSwitch devices to pass through.
GPU_NAME="NVIDIA B200"
# nvidia.com/gpu.product label value (GPU Feature Discovery style).
GPU_PRODUCT=NVIDIA-B200
GPU_COUNT=8
GPU_MEMORY_MIB=184320
GPU_FAMILY=blackwell
GPU_COMPUTE_MAJOR=10
GPU_COMPUTE_MINOR=0
# Shape of the simulated (KWOK) node.
NODE_ARCH=amd64
NODE_CPU=224
NODE_MEMORY=2Ti
