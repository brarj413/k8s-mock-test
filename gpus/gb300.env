# NVIDIA GB300 NVL72 compute tray: 2 Grace CPUs + 4 x B300 GPUs (arm64).
# NVLink switches live in separate switch trays, not on the host's PCIe.
GPU_NAME="NVIDIA GB300"
# nvidia.com/gpu.product label value (GPU Feature Discovery style).
GPU_PRODUCT=NVIDIA-GB300
GPU_COUNT=4
GPU_MEMORY_MIB=284672
GPU_FAMILY=blackwell
GPU_COMPUTE_MAJOR=10
GPU_COMPUTE_MINOR=3
# Shape of the simulated (KWOK) node: Grace is arm64.
NODE_ARCH=arm64
NODE_CPU=144
NODE_MEMORY=960Gi
